# Fill these before implementation begins. Every command runs inside the development container.
# Prefer a single SDD_FULL_VERIFY_COMMAND when your stack provides one.
#
# F1 (Repository / Workspace Foundation) populates ONLY the full-verification command.
# scripts/verify.sh short-circuits on SDD_FULL_VERIFY_COMMAND, so the granular variables below
# would never execute even if set. They are deliberately left empty: F1 provides no lint, format,
# typecheck-only, unit-test or integration-test stage. Those belong to F2 (Quality / Test Tooling),
# which will populate them. An empty value here is the honest state, not an oversight.
SDD_BUILD_COMMAND=""
SDD_LINT_COMMAND=""
SDD_TYPECHECK_COMMAND=""
SDD_UNIT_TEST_COMMAND=""
SDD_INTEGRATION_TEST_COMMAND=""
SDD_FULL_VERIFY_COMMAND="pnpm install --frozen-lockfile && pnpm run verify"
